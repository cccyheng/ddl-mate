# 所有下载与缓存都留在工作区内，不污染全局 npm/pnpm 目录。
cache=../.tools/npm-cache
store-dir=../.tools/pnpm-store
# 依赖布局由 pnpm-workspace.yaml 的 `nodeLinker: hoisted` 决定（见那里的说明）。
# 这里刻意不设 `virtual-store-dir`：hoisted 布局下不需要虚拟store。
# Expo / React Native 生态仍以 npm registry 为唯一来源。
registry=https://registry.npmjs.org/
# 保持 lockfile 精确。
save-exact=false
resolution-mode=highest

{
  "name": "ddl-mate-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "DDL Mate 原生 iOS 客户端（Expo + React Native + TypeScript，原生视图，非 WebView/PWA）",
  "main": "index.ts",
  "type": "module",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:localhost": "expo start --localhost",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup.mjs --test --experimental-test-isolation=none tests/*.test.mjs",
    "doctor": "expo-doctor",
    "check:deps": "expo install --check",
    "export:ios": "expo export --platform ios --output-dir dist-ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.6",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}

# pnpm 依赖与缓存全部落在工作区 .tools 下，避免写入全局环境。
# 注意：.npmrc 里的相对路径是相对 frontend/ 目录解析的，因此这里用 ../.tools。
store-dir=../.tools/pnpm-store
cache-dir=../.tools/npm-cache
strict-peer-dependencies=false
auto-install-peers=true

# 非交互式（CI）安装：需要重建 node_modules 时不再等待 TTY 确认，
# 否则会报 ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY。
# 这只影响"生成的 node_modules"，不会动源码与 pnpm-lock.yaml。
confirm-modules-purge=false

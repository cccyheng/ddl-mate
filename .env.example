# =====================================================================
# DDL Mate 环境变量示例
# 用法（PowerShell，当前会话生效）：
#   Get-Content .env.example | Where-Object { $_ -match '^[A-Z]' } | ForEach-Object {
#     $name, $value = $_ -split '=', 2
#     Set-Item -Path "env:$name" -Value $value
#   }
# 不设置任何变量也能直接启动（默认走 dev profile + H2 文件库）。
# =====================================================================

# ---------- 通用 ----------
# 后端监听地址与端口（默认只绑定本机回环地址，不要改成 0.0.0.0）
DDLMATE_BIND_ADDRESS=127.0.0.1
DDLMATE_SERVER_PORT=8080

# 业务时区（默认固定 Asia/Shanghai）
DDLMATE_TIME_ZONE=Asia/Shanghai

# ---------- 附件存储 ----------
# 图片落盘目录。相对路径以**进程工作目录**为基准：
#   经 scripts\start-backend.ps1（mvn -f backend/pom.xml spring-boot:run）启动时，
#   工作目录是 backend\，因此 ./data/uploads 实际为 backend\data\uploads\。
# 想固定位置就写绝对路径，例如：DDLMATE_UPLOAD_DIR=C:\ddlmate-data\uploads
DDLMATE_UPLOAD_DIR=./data/uploads
# 单文件上限（Spring DataSize 格式）
DDLMATE_MAX_FILE_SIZE=5MB
DDLMATE_MAX_REQUEST_SIZE=20MB

# ---------- 本地单人资料（不是认证） ----------
DDLMATE_USER_NAME=local
DDLMATE_USER_DISPLAY_NAME=本机同学

# ---------- dev profile（H2 文件数据库，默认） ----------
# 数据库文件路径由 application-dev.yml 的 spring.datasource.url 指定，默认：
#   jdbc:h2:file:./data/ddlmate-dev
# 同样是"相对进程工作目录"：经 scripts\start-backend.ps1 启动时 =
#   <工作区>\backend\data\ddlmate-dev.mv.db
DDLMATE_H2_USER=sa
DDLMATE_H2_PASSWORD=

# ---------- mysql profile（正式库，本机未实测） ----------
# 建库脚本：backend/src/main/resources/db/mysql/schema.sql
DDLMATE_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/ddl_mate?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DDLMATE_MYSQL_USER=ddl_mate
DDLMATE_MYSQL_PASSWORD=change-me

# ---------- 依赖缓存（工作区内，scripts 会自动设置） ----------
# Maven 本地仓库与 pnpm store 都指向工作区 .tools，避免修改全局环境
DDLMATE_M2_REPO=.tools/m2/repository
DDLMATE_PNPM_STORE=.tools/pnpm-store

# DDL Mate 网页版（服务器部署）
# 安装位置：/etc/systemd/system/ddlmate.service
# 程序：/opt/ddlmate/app/ddl-mate.jar（指向 /opt/ddlmate/releases/<版本>/ddl-mate.jar 的软链接）
# 数据：/opt/ddlmate/data（H2 数据库、上传图片、恢复前的安全副本）
[Unit]
Description=DDL Mate web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ddlmate
Group=ddlmate
EnvironmentFile=/etc/ddlmate/ddlmate.env
WorkingDirectory=/opt/ddlmate
ExecStart=/usr/bin/java -Xms128m -Xmx512m -Dfile.encoding=UTF-8 -jar /opt/ddlmate/app/ddl-mate.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

# 加固：只允许写数据目录，其余文件系统只读
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ddlmate/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

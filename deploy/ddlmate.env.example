# 服务器环境变量：复制到 /etc/ddlmate/ddlmate.env（root:ddlmate，权限 640）
# 登录密码只写 PBKDF2 哈希：在自己电脑上运行 node scripts/hash-password.mjs 生成
DDLMATE_AUTH_USERNAME=your-name
DDLMATE_AUTH_PASSWORD_HASH=pbkdf2$210000$...$...
DDLMATE_DATA_DIR=/opt/ddlmate/data
DDLMATE_SERVER_PORT=8080
DDLMATE_TIME_ZONE=Asia/Shanghai
DDLMATE_COOKIE_SECURE=true
DDLMATE_USER_DISPLAY_NAME=我
